START move_player

SET currentRoom = "Hidden Leaf Village"

WHILE game is running
  OUTPUT "You are in " + currentRoom
  OUTPUT "Enter a direction: north, south, east, or west"
  INPUT direction

  IF direction is north, south, east, or west THEN
    IF direction is a valid exit from currentRoom THEN
      SET currentRoom = connected room in direction
      OUTPUT "You moved to " + currentRoom
    ELSE
      OUTPUT "You cannot move in that direction."
    END IF
  ELSE
    OUTPUT "Invalid direction. Try again."
  END IF
END WHILE

END move_player
